<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a note" pop-up (QuickCaptureActivity), Build 39 (he picked "A · compact composer", Nov 8): one
     small card near the bottom: a small "to …" line with the logo, the text (one line, grows to 8), then
     one row of tool buttons, each a separate chip with its own fill and edge so it's clear where one ends
     and the next begins, and a round Add at the end (greyed until there's something to add). Colours are
     the app's look, set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/qc_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp">
        <!-- where it goes: the logo, 16dp, and "to <page>" in small faint words -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp">
            <ImageView
                android:id="@+id/qc_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_logo"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/qc_where"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/qc_image"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:contentDescription="The shared picture"
            android:scaleType="centerCrop"
            android:visibility="gone" />
        <TextView
            android:id="@+id/qc_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- the words: no box of its own (the card is the box), one line to start -->
        <EditText
            android:id="@+id/qc_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="top|start"
            android:hint="Add a note…"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="8"
            android:minLines="1"
            android:minHeight="40dp"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:textSize="16sp" />
        <!-- why a note couldn't be added (the text stays above); hidden until then -->
        <TextView
            android:id="@+id/qc_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="13sp"
            android:visibility="gone" />
        <!-- one row: the tools as separate chips (6dp apart), then Add -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/qc_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button android:id="@+id/qc_link" android:layout_width="wrap_content" android:layout_height="36dp"
                    android:minWidth="44dp" android:minHeight="0dp" android:paddingStart="9dp" android:paddingEnd="9dp"
                    android:paddingTop="0dp" android:paddingBottom="0dp" android:includeFontPadding="false" android:gravity="center"
                    android:stateListAnimator="@null" android:text="[[ ]]" android:textAllCaps="false" android:textSize="13sp"
                    android:fontFamily="monospace" android:contentDescription="Page link" />
                <Button android:id="@+id/qc_tag" android:layout_width="40dp" android:layout_height="36dp"
                    android:layout_marginStart="6dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:includeFontPadding="false" android:gravity="center"
                    android:stateListAnimator="@null" android:text="#" android:textAllCaps="false" android:textSize="15sp"
                    android:fontFamily="monospace" android:contentDescription="Tag" />
                <ImageButton android:id="@+id/qc_todo" android:layout_width="40dp" android:layout_height="36dp"
                    android:layout_marginStart="6dp" android:src="@drawable/qc_todo" android:scaleType="center" android:padding="0dp"
                    android:contentDescription="Make it a to-do" />
                <ImageButton android:id="@+id/qc_newline" android:layout_width="40dp" android:layout_height="36dp"
                    android:layout_marginStart="6dp" android:src="@drawable/qc_newline" android:scaleType="center" android:padding="0dp"
                    android:contentDescription="New line" />
                <ImageButton android:id="@+id/qc_paste" android:layout_width="40dp" android:layout_height="36dp"
                    android:layout_marginStart="6dp" android:src="@drawable/qc_paste" android:scaleType="center" android:padding="0dp"
                    android:contentDescription="Paste" />
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:minWidth="8dp" />
            <ImageButton
                android:id="@+id/qc_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/qc_send"
                android:scaleType="center"
                android:padding="0dp"
                android:contentDescription="Add" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
