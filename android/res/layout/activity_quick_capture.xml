<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a note" pop-up (QuickCaptureActivity): a rounded card near the bottom of the screen, in the
     colours of the app's look (set in code, so they follow the look the app last used). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/qc_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <!-- compact (Build 34, he asked: less empty space at the top and bottom, the same text sizes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- thinky's icon (he asked, Oct 30: the logo, not a plus) -->
            <ImageView
                android:id="@+id/qc_badge"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/widget_logo"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/qc_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Add a note"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/qc_where"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/qc_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:contentDescription="The shared picture"
            android:scaleType="centerCrop"
            android:visibility="gone" />
        <TextView
            android:id="@+id/qc_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="13sp"
            android:visibility="gone" />
        <EditText
            android:id="@+id/qc_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:hint="Type or paste a note…"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="8"
            android:minLines="2"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp"
            android:textSize="16sp" />
        <!-- a small toolbar (he asked, Oct 30: small buttons in a row, lined up; then centred under the text
             box, his comment on the Build 33 review): a new line, a page link, a tag, a to-do -->
        <LinearLayout
            android:id="@+id/qc_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/qc_newline" android:layout_width="40dp" android:layout_height="30dp"
                android:src="@drawable/qc_newline" android:scaleType="center" android:padding="0dp"
                android:contentDescription="New line" />
            <Button android:id="@+id/qc_link" android:layout_width="wrap_content" android:layout_height="30dp"
                android:layout_marginStart="6dp" android:minWidth="40dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:includeFontPadding="false" android:gravity="center"
                android:stateListAnimator="@null" android:text="[[ ]]" android:textAllCaps="false" android:textSize="13sp"
                android:fontFamily="monospace" android:contentDescription="Page link" />
            <Button android:id="@+id/qc_tag" android:layout_width="wrap_content" android:layout_height="30dp"
                android:layout_marginStart="6dp" android:minWidth="40dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:includeFontPadding="false" android:gravity="center"
                android:stateListAnimator="@null" android:text="#" android:textAllCaps="false" android:textSize="13sp"
                android:fontFamily="monospace" android:contentDescription="Tag" />
            <Button android:id="@+id/qc_todo" android:layout_width="wrap_content" android:layout_height="30dp"
                android:layout_marginStart="6dp" android:minWidth="40dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:includeFontPadding="false" android:gravity="center"
                android:stateListAnimator="@null" android:text="☐ To-do" android:textAllCaps="false" android:textSize="13sp"
                android:contentDescription="Make it a to-do" />
        </LinearLayout>
        <!-- why a note couldn't be added (the text stays above); hidden until then -->
        <TextView
            android:id="@+id/qc_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/qc_paste"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="Paste"
                android:textAllCaps="false"
                android:textSize="15sp" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <Button
                android:id="@+id/qc_add"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="104dp"
                android:minHeight="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="Add"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
